<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude the Room database and its support files from cloud backups -->
        <exclude
            domain="database"
            path="countries_db" />
        <exclude
            domain="database"
            path="countries_db-shm" />
        <exclude
            domain="database"
            path="countries_db-wal" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude the Room database and its support files from device-to-device transfers -->
        <exclude
            domain="database"
            path="countries_db" />
        <exclude
            domain="database"
            path="countries_db-shm" />
        <exclude
            domain="database"
            path="countries_db-wal" />
    </device-transfer>
</data-extraction-rules>
